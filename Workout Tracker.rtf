<body>\
<div id="app"></div>\
\
<script>\
const app = document.getElementById("app");\
\
const DAYS = ["Day 1","Day 2","Day 3","Day 4","Day 5","Day 6"];\
\
let state = \{\
    page:"home",\
    currentDay:null,\
    currentExercise:null\
\};\
\
if(!localStorage.getItem("liftData"))\{\
    localStorage.setItem("liftData", JSON.stringify(\{\
        "Day 1":[\
            \{name:"Incline Dumbbell Press", history:[]\},\
            \{name:"Cable Fly", history:[]\},\
            \{name:"Machine Press", history:[]\}\
        ],\
        "Day 2":[\
            \{name:"Lat Pulldown", history:[]\},\
            \{name:"Cable Row", history:[]\}\
        ],\
        "Day 3":[],\
        "Day 4":[],\
        "Day 5":[],\
        "Day 6":[]\
    \}));\
\}\
\
function getData()\{\
    return JSON.parse(localStorage.getItem("liftData"));\
\}\
\
function saveData(data)\{\
    localStorage.setItem("liftData", JSON.stringify(data));\
\}\
\
function render()\{\
    if(state.page === "home") renderHome();\
    if(state.page === "day") renderDay();\
    if(state.page === "exercise") renderExercise();\
\}\
\
function renderHome()\{\
    app.innerHTML = `\
        <div class="header">\
            <div class="title">Lift</div>\
            <div class="sub">Minimal workout tracking</div>\
        </div>\
\
        <div class="content">\
            $\{DAYS.map(day=>`\
                <div class="card day-card" onclick="openDay('$\{day\}')">\
                    <div class="day-title">$\{day\}</div>\
                    <div class="arrow">\'9b</div>\
                </div>\
            `).join("")\}\
        </div>\
    `;\
\}\
\
function openDay(day)\{\
    state.page = "day";\
    state.currentDay = day;\
    render();\
\}\
\
function renderDay()\{\
    const data = getData();\
    const exercises = data[state.currentDay];\
\
    app.innerHTML = `\
        <div class="header">\
            <div class="back" onclick="goHome()">
\f1 \uc0\u8592 
\f0  Home</div>\
            <div class="title">$\{state.currentDay\}</div>\
        </div>\
\
        <div class="content">\
            <input class="search" placeholder="Search workouts..." oninput="searchExercises(this.value)" />\
\
            <div id="exerciseList">\
                $\{renderExerciseCards(exercises)\}\
            </div>\
\
            <button class="button" onclick="addExercise()">Add Workout</button>\
        </div>\
    `;\
\}\
\
function renderExerciseCards(exercises)\{\
    if(exercises.length === 0)\{\
        return `<div class="empty">No workouts yet</div>`;\
    \}\
\
    return exercises.map((exercise,index)=>\{\
\
        let latest = "No history";\
\
        if(exercise.history.length)\{\
            const last = exercise.history[exercise.history.length - 1];\
            latest = `$\{last.sets[0]?.weight || 0\} lbs`;\
        \}\
\
        return `\
            <div class="card" onclick="openExercise($\{index\})">\
                <div class="exercise-name">$\{exercise.name\}</div>\
                <div class="exercise-meta">$\{latest\}</div>\
            </div>\
        `;\
    \}).join("");\
\}\
\
function searchExercises(value)\{\
    const data = getData();\
    const exercises = data[state.currentDay];\
\
    const filtered = exercises.filter(e=>\
        e.name.toLowerCase().includes(value.toLowerCase())\
    );\
\
    document.getElementById("exerciseList").innerHTML =\
        renderExerciseCards(filtered);\
\}\
\
function addExercise()\{\
    const name = prompt("Workout name");\
\
    if(!name) return;\
\
    const data = getData();\
\
    data[state.currentDay].push(\{\
        name,\
        history:[]\
    \});\
\
    saveData(data);\
    render();\
\}\
\
function openExercise(index)\{\
    state.page = "exercise";\
    state.currentExercise = index;\
    render();\
\}\
\
function renderExercise()\{\
    const data = getData();\
    const exercise = data[state.currentDay][state.currentExercise];\
\
    const last3 = [...exercise.history].reverse().slice(0,3);\
\
    app.innerHTML = `\
        <div class="header">\
            <div class="back" onclick="backToDay()">
\f1 \uc0\u8592 
\f0  $\{state.currentDay\}</div>\
            <div class="title">$\{exercise.name\}</div>\
        </div>\
\
        <div class="content">\
\
            <div class="card">\
                <div class="set-row">\
                    <div>Set</div>\
                    <div>Weight</div>\
                    <div>Reps</div>\
                </div>\
\
                $\{[1,2,3,4].map(i=>`\
                    <div class="set-row">\
                        <div>$\{i\}</div>\
                        <input class="input weight" type="number" placeholder="lbs">\
                        <input class="input reps" type="number" placeholder="reps">\
                    </div>\
                `).join("")\}\
\
                <button class="button" onclick="saveWorkout()">\
                    Save Workout\
                </button>\
            </div>\
\
            <div class="history-block">\
                <div class="history-title">Last 3 Sessions</div>\
\
                $\{\
                    last3.length\
                    ? last3.map(h=>`\
                        <div class="history-item">\
                            $\{h.date\}<br>\
                            $\{\
                                h.sets.map(s=>\
                                    `$\{s.weight\} \'d7 $\{s.reps\}`\
                                ).join("<br>")\
                            \}\
                        </div>\
                    `).join("")\
                    : `<div class="history-item">No history yet</div>`\
                \}\
            </div>\
\
            <canvas id="chart" width="320" height="180"></canvas>\
\
        </div>\
    `;\
\
    drawChart(exercise.history);\
\}\
\
function saveWorkout()\{\
    const weights = document.querySelectorAll(".weight");\
    const reps = document.querySelectorAll(".reps");\
\
    const sets = [];\
\
    for(let i=0;i<weights.length;i++)\{\
\
        const weight = weights[i].value;\
        const rep = reps[i].value;\
\
        if(weight && rep)\{\
            sets.push(\{\
                weight:Number(weight),\
                reps:Number(rep)\
            \});\
        \}\
    \}\
\
    if(!sets.length) return;\
\
    const data = getData();\
\
    data[state.currentDay][state.currentExercise].history.push(\{\
        date:new Date().toLocaleDateString(),\
        sets\
    \});\
\
    saveData(data);\
\
    render();\
\}\
\
function drawChart(history)\{\
    const canvas = document.getElementById("chart");\
\
    if(!canvas) return;\
\
    const ctx = canvas.getContext("2d");\
\
    ctx.clearRect(0,0,canvas.width,canvas.height);\
\
    ctx.strokeStyle = "white";\
    ctx.lineWidth = 2;\
\
    if(history.length < 2)\{\
        ctx.fillStyle = "#666";\
        ctx.font = "16px Times New Roman";\
        ctx.fillText("More workouts needed for chart",40,90);\
        return;\
    \}\
\
    const points = history.map(h=>h.sets[0]?.weight || 0);\
\
    const max = Math.max(...points);\
\
    ctx.beginPath();\
\
    points.forEach((p,i)=>\{\
        const x = (i/(points.length-1))*280 + 20;\
        const y = 150 - ((p/max)*100);\
\
        if(i===0) ctx.moveTo(x,y);\
        else ctx.lineTo(x,y);\
    \});\
\
    ctx.stroke();\
\}\
\
function goHome()\{\
    state.page = "home";\
    render();\
\}\
\
function backToDay()\{\
    state.page = "day";\
    render();\
\}\
\
render();\
</script>\
</body>\
</html>}